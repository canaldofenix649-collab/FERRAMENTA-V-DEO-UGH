# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# E-mail da conta que terá acesso ao painel /admin.html
ADMIN_EMAIL=seu-email@exemplo.com

# Créditos grátis para cada nova conta e custo de cada geração
FREE_CREDITS=3
COST_VIRAL=1
COST_UGC=2
COST_VIDEO=3

# Modelo de IA (claude-opus-5-5 = melhor qualidade; claude-sonnet-5-5 = mais barato)
CLAUDE_MODEL=claude-opus-5-5

# ---------- Vídeo MP4 (opcional) ----------
# Sem essas chaves o MP4 ainda é gerado, mas com fundos simples (ou a foto do produto) e sem narração.

# Imagens das cenas com IA (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low = mais barato, medium = equilíbrio, high = melhor qualidade
OPENAI_IMAGE_QUALITY=medium

# ---------- Voz: narração e clonagem ----------
# Qual serviço usar: "ai33" ou "elevenlabs". Em branco = o primeiro que tiver chave (ai33 primeiro).
VOICE_PROVIDER=ai33

# Opção 1: ai33.pro (painel → API Document → API Key)
AI33_API_KEY=
# Vozes padrão (IDs com prefixo, veja a lista em GET /v3/voices). Ex.: elevenlabs_..., minimax_..., edge_pt-BR-FranciscaNeural
AI33_VOICE_ID=elevenlabs_JBFqnCBsd6RMkjVDRZzb
AI33_VOICE_ID_UGC=elevenlabs_21m00Tcm4TlvDq8ikWAM
# Velocidade da fala (0.5 a 1.5)
AI33_SPEED=1

# Opção 2: ElevenLabs oficial (https://elevenlabs.io → Developers → API Keys)
ELEVENLABS_API_KEY=
# Vozes (troque pelo ID de qualquer voz da sua conta ElevenLabs)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID_UGC=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Clonagem da voz do próprio usuário (usa o serviço de voz escolhido acima)
VOICE_CLONE_ENABLED=true
# Créditos cobrados para clonar a voz (0 = grátis)
COST_VOICE_CLONE=0

# Quantos vídeos podem ser renderizados ao mesmo tempo
MAX_PARALLEL_RENDERS=2

# Pasta onde fica o banco de dados (usuários, créditos, histórico)
DATA_DIR=./data

PORT=3000

# Em produção (atrás de Render, Railway, Nginx...), descomente:
# NODE_ENV=production
# TRUST_PROXY=1
