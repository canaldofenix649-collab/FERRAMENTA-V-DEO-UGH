{
  // Configuração do Cloudflare. O banco de dados (D1) é criado sozinho na primeira publicação.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ferramenta-v-deo-ugh",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/manifest.webmanifest"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "gestao-barbearia" }],
  "observability": { "enabled": true }
}
